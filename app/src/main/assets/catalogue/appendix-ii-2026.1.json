{
  "catalogueId": "easa-amc-part66-appendix-ii",
  "version": "2026.1",
  "status": "IN_FORCE",
  "source": "Appendix II to AMC to Annex III (Part-66), ED Decision 2023/019/R",
  "sourceRevision": "Easy Access Rules for Continuing Airworthiness, September 2025",
  "displayName": "Appendix II to AMC to Annex III (Part-66)",
  "references": {
    "B": "Appendix II to AMC to Annex III (Part-66) — Table B, Specific tasks for sailplanes and powered sailplanes",
    "A_ENGINE": "Appendix II to AMC to Annex III (Part-66) — Table A, Specific tasks for aeroplanes, referenced from Table B"
  },
  "notes": "Metal structures is tagged to all four subcategories: the section title refers to all-metal gliders, but metal fittings occur in wood/fabric and composite aircraft alike and the tasks are creditable there. Wood/fabric remains restricted, since a composite glider has no plywood skin or fabric covering. Table B in full, plus the Table A blocks cross-referenced by Table B: propeller, piston engine, fuel and control, ignition, engine indications and exhaust.",
  "thresholds": {
    "L1": 0.5,
    "L1C": 0.5,
    "L2": 0.5,
    "L2C": 0.5,
    "rule": "AMC 66.A.45(d);(e)3;(f)1;(g)1;(h) — 50% of tasks relevant to the licence category and applicable ratings, covering tasks from each paragraph"
  },
  "statements": {
    "ML_A_801_B2_INDEPENDENT": "certifies that the work specified, except as otherwise specified, was carried out in accordance with Part-ML, and in respect to that work, the aircraft is considered ready for release to service.",
    "ML_A_803_PILOT_OWNER": "certifies that the limited pilot-owner maintenance specified, except as otherwise specified, was carried out in accordance with Part-ML, and in respect to that work, the aircraft is considered ready for release to service."
  },
