<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches PdfAttachments.kt's copy destination: context.filesDir/documents/. -->
    <files-path name="documents" path="documents/" />
    <!-- Matches CrsRepository's rendered-PDF destination: context.filesDir/crs/. -->
    <files-path name="crs" path="crs/" />
    <!-- Matches SigningInfoViewModel's exported-PDF destination: context.filesDir/signing/. -->
    <files-path name="signing" path="signing/" />
    <!-- Matches WorkPhotoAttachments' processed-photo destination and camera-capture staging file: context.filesDir/attachments/. -->
    <files-path name="attachments" path="attachments/" />
    <!-- Matches CrsExport.kt's zip destination: context.filesDir/crs-export/. -->
    <files-path name="crs-export" path="crs-export/" />
</paths>
