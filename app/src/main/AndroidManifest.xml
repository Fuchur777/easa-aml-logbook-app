<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- For CrsSigner's per-use biometric-gated Android Keystore key (§9.3). No runtime prompt — this is a normal permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- For photographing work as evidence (§8) — a runtime-requested permission; the gallery picker remains available without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- For Google Drive backup (§10) — the app is fully functional offline without it; this only gates the optional sync feature. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup is still the template default, and is an open decision before publishing.

      Left on, Android Auto Backup copies filesDir and the Room database — signed
      certificates, work photos, the connected Drive account — into the user's Google
      backup. That sits awkwardly beside the spec's "no server holds user data, ever",
      and beside the app's own explicit Drive backup, which the user controls and can see.

      It also restores oddly: Android Keystore keys are non-exportable and never travel, so
      a restored install has certificates signed by a key alias that no longer exists on
      that device.

      Turning it off means a user who loses their phone without having run a Drive backup
      loses everything — which is the honest trade, but it should be Frank's call.
    -->
    <application
        android:name=".Part66LogApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Part66Log">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Part66Log"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants a viewer app temporary read access to a copied PDF without exposing filesDir directly. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
